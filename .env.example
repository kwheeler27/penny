# Penny — environment variables
#
# Every var below is OPTIONAL in dev. With nothing set, `packages/db`'s db
# factory falls back to a local PGlite instance (zero config, no credentials)
# and ingest jobs run against fixtures in `db/fixtures` via `pnpm seed`
# rather than live APIs. Set these only to hit real Neon / real source APIs.

# Neon Postgres connection string. Unset -> PGlite (dev/test/seed default).
# Get one at https://neon.tech (free tier).
DATABASE_URL=

# Where the fallback PGlite database lives on disk (gitignored). Defaults to
# .pglite/penny at the repo root, which is what makes `pnpm seed` and
# `pnpm --filter @penny/web run dev` see the same data. Leave unset unless
# you need a different location.
# PGLITE_DATA_DIR=

# Treasury FiscalData (MTS, Debt to the Penny, Daily Treasury Statement) is
# keyless for GET requests. This is only needed if a higher rate limit via
# api.data.gov is required later.
# FISCALDATA_API_KEY=

# FRED (Federal Reserve data, Phase 2+). Free, instant key:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# BLS API v2 (CPI-U). Free, instant key, raises the daily query limit:
# https://www.bls.gov/developers/
BLS_API_KEY=
