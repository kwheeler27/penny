{
  "name": "penny",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen": "pnpm --filter @penny/registry run gen",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "seed": "pnpm --filter @penny/db run seed",
    "build": "pnpm -r --if-present run build",
    "qa:screens": "node scripts/qa-screens.mjs"
  }
}
